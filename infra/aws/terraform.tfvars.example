aws_region   = "ap-southeast-1"
project_name = "foodlink"
environment  = "prod"

ssh_key_name            = "foodlink-prod"
ssh_allowed_cidr_blocks = ["203.0.113.10/32"]

container_image = "ghcr.io/christolx/foodlink-api:latest"

# Only needed if the GHCR package is private.
# registry_username = "christolx"
# registry_token    = "github_pat_replace_me"

database_name           = "foodlink"
database_username       = "foodlink_admin"
database_instance_class = "db.t4g.micro"

# Free Plan-compatible default. Increase after upgrading the AWS account plan.
database_backup_retention_days = 1

# Demo defaults. Enable both protections for persistent production data.
database_deletion_protection   = false
database_skip_final_snapshot   = true

demo_jwt_secret = "replace-with-long-random-secret"

allowed_origins = [
  "https://foodlink.example.com",
]
